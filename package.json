{
  "name": "building-agentic-workflows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate": "node --experimental-strip-types scripts/validate-content.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "export:pdf": "node scripts/export-pdf.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run export:pdf && npm run test:e2e",
    "demo:validate": "node examples/validator.mjs"
  },
  "dependencies": {
    "@primer/css": "22.3.3",
    "@primer/primitives": "11.10.0",
    "marked": "18.1.3",
    "reveal.js": "6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/reveal.js": "5.2.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
